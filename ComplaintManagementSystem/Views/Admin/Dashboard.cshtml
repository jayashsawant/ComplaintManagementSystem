@model List<ComplaintManagementSystem.Models.Complaint>

@{
    ViewData["Title"] = "Manage Complaints";
    var complaints = Model ?? new List<ComplaintManagementSystem.Models.Complaint>();
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold">
            <i class="bi bi-shield-check"></i> Manage Complaints
        </h3>
    </div>

    <!-- Complaints Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            @if (!complaints.Any())
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-inbox fs-2"></i>
                    <p class="mt-2">No complaints available</p>
                </div>
            }
            else
            {
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>User</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var c in complaints)
                        {
                            <tr>
                                <td class="fw-semibold">@c.User?.Name</td>

                                <td>
                                    @(
                                                                c.Description.Length > 60
                                                                ? c.Description.Substring(0, 60) + "..."
                                                                : c.Description
                                                                )
                            </td>

                                <!-- Status Badge -->
                                <td>
                            @if (c.Status.ToString() == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (c.Status.ToString() == "InProgress")
                                    {
                                        <span class="badge bg-info text-dark">In Progress</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Resolved</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <a asp-controller="Admin"
                                       asp-action="Edit"
                                       asp-route-id="@c.ComplaintId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}



