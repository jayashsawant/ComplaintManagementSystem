@model ComplaintManagementSystem.Models.Complaint
@using ComplaintManagementSystem.Models.Enums

@{
    ViewData["Title"] = "Create Complaint";
}

@if (TempData["insert_message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <strong> Success!</strong> @TempData["insert_message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center">
                    <h5 class="mb-0">
                        <i class="bi bi-exclamation-circle"></i>
                        Register Complaint
                    </h5>
                </div>

                <div class="card-body p-4">

                    <form asp-controller="Complaint" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- User Dropdown -->
                        <div class="mb-3">
                            <label asp-for="UserId" class="form-label fw-semibold">
                                Select User
                            </label>
                            <select asp-for="UserId"
                                    class="form-select"
                                    asp-items="ViewBag.UserId">
                                <option value="">-- Choose User --</option>
                            </select>
                            <span asp-validation-for="UserId" class="text-danger"></span>
                        </div>

                        <!-- Complaint Description -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">
                                Complaint Description
                            </label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe your issue clearly..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-controller="Complaint"
                               asp-action="List"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Back
                            </a>

                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-send"></i> Submit
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}




